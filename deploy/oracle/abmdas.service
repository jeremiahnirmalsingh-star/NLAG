[Unit]
Description=ABMDAS Node.js backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/abmdas
EnvironmentFile=/home/ubuntu/abmdas/.env
ExecStart=/usr/bin/node /home/ubuntu/abmdas/server/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target